			status = "disabled";
		};
		disp0: display-pipe@488000000 {
			compatible = "apple,t6050-display-pipe", "apple,disp0-t605x";
			reg = <0x4 0x88000000 0x0 0x4000000>,	/* disp fe */
			      <0x4 0x8a240000 0x0 0x10000>,
			      <0x4 0x8a3ac000 0x0 0x4000>,
			      <0x4 0x8a800000 0x0 0x800000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 980 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 980..990,1000 (13) — TODO verify AIC (U4) */
			iommus = <&dart_disp0 0>;
			/* power-domains: pmgr power-gates 608,607,605 */
			status = "disabled";
		};
		dart_dcp: iommu@48a340000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x4 0x8a340000 0x0 0x20000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 990 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
			/* ADT dart-id 19, sid-count 32 */
			status = "disabled";
