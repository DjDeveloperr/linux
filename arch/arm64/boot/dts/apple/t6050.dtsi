		dart_disp0: iommu@48a300000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x4 0x8a300000 0x0 0xc000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 990 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
