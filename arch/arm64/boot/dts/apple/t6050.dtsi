		dcpext1: dcp@392e00000 {
			compatible = "apple,t6050-dcpext", "apple,dcpext";
			reg = <0x3 0x92e00000 0x0 0x88000>,
			      <0x3 0x92850000 0x0 0x4000>;
			reg-names = "coproc", "mbox";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1195 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 1195..1202 (7) — TODO verify AIC (U4) */
			iommus = <&dart_dcpext1 0>;
			/* power-domains: pmgr power-gate 611 */
			status = "disabled";
		};
		dart_dcpext1: iommu@392340000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x3 0x92340000 0x0 0x20000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1142 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
			/* ADT dart-id 24, sid-count 32 */
			status = "disabled";
		};
		dcpext2: dcp@302e00000 {
			compatible = "apple,t6050-dcpext", "apple,dcpext";
			reg = <0x3 0x02e00000 0x0 0x88000>,
			      <0x3 0x02850000 0x0 0x4000>;
			reg-names = "coproc", "mbox";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1267 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 1267..1274 (8) — TODO verify AIC (U4) */
			iommus = <&dart_dcpext2 0>;
			/* power-domains: pmgr power-gate 612 */
			status = "disabled";
		};
		dart_dcpext2: iommu@302340000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x3 0x02340000 0x0 0x20000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1214 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
			/* ADT dart-id 27, sid-count 32 */
			status = "disabled";
		};
		dcpext3: dcp@306e00000 {
			compatible = "apple,t6050-dcpext", "apple,dcpext";
			reg = <0x3 0x06e00000 0x0 0x88000>,
			      <0x3 0x06850000 0x0 0x4000>;
			reg-names = "coproc", "mbox";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1339 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 1339..1346 (8) — TODO verify AIC (U4) */
			iommus = <&dart_dcpext3 0>;
			/* power-domains: pmgr power-gate 613 */
			status = "disabled";
		};
		dart_dcpext3: iommu@306340000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x3 0x06340000 0x0 0x20000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1286 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
			/* ADT dart-id 30, sid-count 32 */
			status = "disabled";
		};

		/*
		 * ======================================================
		 *  Audio: AOP + AUSS + admac-evolution (all disabled)
		 * ======================================================
		 * On T6050 the AP-visible MCA is gone; audio is behind
		 * coprocessors. No amp unmute is possible without speakersafetyd.
		 */
		dart_aop: iommu@290fc0000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x2 0x90fc0000 0x0 0xc000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 616 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
			/* ADT dart-id 10, sid-count 17. NOTE: reg[1] is GAPF/PS_PROT,
			 * NOT a DAPF aperture (audit) — do not init DAPF here. */
			status = "disabled";
		};
		aop: aop@290600000 {
			compatible = "apple,t6050-aop", "apple,aop";
			reg = <0x2 0x90600000 0x0 0x88000>,	/* asc */
			      <0x2 0x90650000 0x0 0x4000>,
			      <0x2 0x90c00000 0x0 0x2f0000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 578 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 578..581 — TODO verify AIC (U4) */
			iommus = <&dart_aop 0>;
			status = "disabled";
		};
		auss_cpu0: aoss@395d08000 {
			compatible = "apple,t6050-auss", "apple,mxwrap";
			reg = <0x3 0x95d08000 0x0 0x4000>,
			      <0x3 0x95d00000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 2347 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 2346..2349 — TODO verify AIC (U4) */
			status = "disabled";
		};
		dart_auss0: iommu@395d60000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x3 0x95d60000 0x0 0xc000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 2343 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
			/* ADT dart-id 17, sid-count 138 */
			status = "disabled";
		};
		usb_auss0: usb@3953f0000 {
			compatible = "apple,t6050-usb-auss";
			reg = <0x3 0x953f0000 0x0 0x4600>;	/* ADT reg[0]; +9 aux windows omitted */
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 2339 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 2339..2342 — TODO verify AIC (U4) */
			iommus = <&dart_auss0 0>;
			status = "disabled";
		};
		admac_base_ns: dma-controller@293800000 {
			compatible = "apple,t6050-admac-evolution", "apple,admac-evolution";
			reg = <0x2 0x93800000 0x0 0x34000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 637 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#dma-cells = <1>;
			status = "disabled";
		};
		admac_leap_ns: dma-controller@293300000 {
			compatible = "apple,t6050-admac-evolution", "apple,admac-evolution";
			reg = <0x2 0x93300000 0x0 0x34000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 639 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#dma-cells = <1>;
			status = "disabled";
		};
		admac_leap_s: dma-controller@293200000 {
			compatible = "apple,t6050-admac-evolution", "apple,admac-evolution";
			reg = <0x2 0x93200000 0x0 0x34000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 638 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#dma-cells = <1>;
			status = "disabled";
		};

		/*
		 * ======================================================
		 *  Touch ID: SEP + its DART + exclave manager
		 * ======================================================
		 * The mesa biosensor is a child of spi2 (board dts). Keep disabled;
		 * exclave-gated, passive-only.
		 */
		dart_sep: iommu@500b80000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x5 0x00b80000 0x0 0x20000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 543 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
			/* ADT dart-id 13, sid-count 3 */
			status = "disabled";
		};
		sep: sep@502600000 {
			compatible = "apple,t6050-sep", "apple,sep";
			reg = <0x5 0x02600000 0x0 0x88000>,
			      <0x5 0x02050000 0x0 0x4000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 534 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 533..536 — TODO verify AIC (U4) */
			iommus = <&dart_sep 0>;
			/* power-domains: pmgr power-gate 185 */
			status = "disabled";
		};
		sep_esm: sep-manager@54267c000 {
			/*
			 * PARTIAL: ADT reg 0x5_4267c000 is OUTSIDE the /arm-io ranges
			 * window (exclave carve-out); cannot translate via ranges.
			 * Address is the raw ADT value; TODO confirm CPU-phys.
			 */
			compatible = "apple,t6050-sep-exclave-manager";
			reg = <0x5 0x4267c000 0x0 0x4000>;	/* RAW ADT — TODO verify */
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 540 IRQ_TYPE_LEVEL_HIGH>, /* ADT irq 540,537 — TODO verify AIC (U4) */
				     <AIC_IRQ 537 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		/*
		 * ======================================================
		 *  ANE (Apple Neural Engine) — exclave-gated, descriptive only
		 * ======================================================
		 */
		dart_ane0: iommu@509800000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x5 0x09800000 0x0 0xc000>,
			      <0x5 0x09820000 0x0 0xc000>,
			      <0x5 0x09840000 0x0 0xc000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 955 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
			/* ADT dart-id 40, sid-count 16 (SIDs 0-7,11); pmgr power-gate 568 */
			status = "disabled";
		};
		ane0: ane@508000000 {
			compatible = "apple,t6050-ane", "apple,ane-t8132exclave";
			reg = <0x5 0x08000000 0x0 0x2000000>,	/* ANE core */
			      <0x5 0x84000000 0x0 0x2000000>;	/* ANE exclave window */
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 954 IRQ_TYPE_LEVEL_HIGH>, /* ADT irq 954,967 — TODO verify AIC (U4) */
				     <AIC_IRQ 967 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&dart_ane0 0>;
			/* power-domains: pmgr power-gates 569,664 (pmgr dev 0x238) */
			status = "disabled";
		};

		/*
		 * ==== NVMe/ANS + SMC (disabled; described for completeness) ====
		 */
		ans: nvme@419600000 {
			compatible = "apple,t6050-ans", "apple,ans";
			reg = <0x4 0x19600000 0x0 0x88000>,
			      <0x4 0x19050000 0x0 0x4000>;
			reg-names = "coproc", "mbox";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1348 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 1347..1350,2338 — TODO verify AIC (U4) */
			/* NVMe controller node + sart wiring TODO (internal storage,
			 * separate stack per audit U17) */
			status = "disabled";
		};
		smc: smc@28c600000 {
			compatible = "apple,t6050-smc", "apple,t8103-smc";
			reg = <0x2 0x8c600000 0x0 0x88000>,
			      <0x2 0x8c050000 0x0 0x4000>,
			      <0x2 0x8c810000 0x0 0x100>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 900 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 899..902 — TODO verify AIC (U4) */
			/* Experimental: crashes ~1s into MTP interaction (audit U13). */
			status = "disabled";
		};
	};
};
