			reg-names = "coproc", "mbox";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1044 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 1043..1050 (8) — TODO verify AIC (U4) */
			iommus = <&dart_dcp 0>;
			/* power-domains: pmgr power-gate 606 */
			status = "disabled";
