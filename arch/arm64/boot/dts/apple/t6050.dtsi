		dcpext0: dcp@2b2e00000 {
			compatible = "apple,t6050-dcpext", "apple,dcpext";
			reg = <0x2 0xb2e00000 0x0 0x88000>,
			      <0x2 0xb2850000 0x0 0x4000>;
			reg-names = "coproc", "mbox";
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1123 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq 1123..1130 (7) — TODO verify AIC (U4) */
			iommus = <&dart_dcpext0 0>;
			/* power-domains: pmgr power-gate 610 */
			status = "disabled";
		};
		dart_dcpext0: iommu@2b2340000 {
			compatible = "apple,t6050-dart", "apple,t8110-dart";
			reg = <0x2 0xb2340000 0x0 0x20000>;
			interrupt-parent = <&aic>;
			interrupts = <AIC_IRQ 1070 IRQ_TYPE_LEVEL_HIGH>; /* ADT irq — TODO verify AIC (U4) */
			#iommu-cells = <1>;
